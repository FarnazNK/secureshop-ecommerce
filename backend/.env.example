# Backend .env — for running uvicorn directly (without Docker).
# In Docker compose, env comes from the root .env via compose.yml.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://secureshop:secureshop@localhost:5432/secureshop

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth secrets (each at least 32 chars; generate with `openssl rand -base64 48`) ---
JWT_ACCESS_SECRET=replace-me-with-a-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-secret-at-least-32-chars
ENCRYPTION_KEY=replace-me-with-an-encryption-key-at-least-32-chars

# --- App ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=INFO
COOKIE_SECURE=false

# --- Scaling (defaults suit one local server) ---
# RATE_LIMIT_BACKEND=memory   # "database" to share limits across instances (serverless, several pods)
# DB_POOL_DISABLED=false      # true on serverless (Vercel)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=5   # then 503 "server busy"
# DB_COMMAND_TIMEOUT_SECONDS=15

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Stripe (optional; without a key, checkout runs in demo mode) ---
# Use TEST keys (sk_test_...). For local webhooks: `stripe listen --forward-to localhost:3001/api/v1/payments/webhook`
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd
# STRIPE_TIMEOUT_SECONDS=10          # per Stripe call; then the circuit breaker counts a failure
# STRIPE_BREAKER_FAILURE_THRESHOLD=5 # failures within STRIPE_BREAKER_WINDOW_SECONDS that open it
# Where Stripe sends customers back after paying (the storefront URL).
FRONTEND_URL=http://localhost:5173
